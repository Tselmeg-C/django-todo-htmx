# SQLite is used when DB_ENGINE is unset.
# Uncomment all DB_* values to configure PostgreSQL.
# DB_ENGINE=postgresql
# DB_NAME=django_todo
# DB_USER=django_todo
# DB_PASSWORD=replace-me
# DB_HOST=localhost
# DB_PORT=5432

# Set a unique secret outside local development.
# DJANGO_SECRET_KEY=replace-me
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=todo.example.com
